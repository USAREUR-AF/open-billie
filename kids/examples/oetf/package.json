{
  "name": "open-billie-oetf-example",
  "version": "0.1.0",
  "private": true,
  "description": "Billie OETF (Open Example Track Format) \u2014 a non-proprietary stand-in source system, implemented in TypeScript, Python and Rust",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "gen:schemas": "python tools/gen-schemas.py",
    "test:py": "cd packages/oetf/python && python -m pytest -q",
    "test:rs": "cd packages/oetf/rust && cargo test",
    "test:all": "pnpm test && pnpm test:py && pnpm test:rs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.0",
    "@types/node": "^25.9.1",
    "typescript": "~5.9.3",
    "vite-node": "^2.1.0",
    "vitest": "^2.1.0",
    "yaml": "^2.6.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
