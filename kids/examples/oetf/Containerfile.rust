# Development image for the synthetic OETF Rust kid. Keep compiler and OS
# release versions explicit; release bundles record the resolved OCI digest.
FROM docker.io/library/rust:1.85.1-slim-bookworm AS build

WORKDIR /src
COPY packages/oetf/rust ./packages/oetf/rust
COPY packages/oetf/shared ./packages/oetf/shared
RUN cargo build --release --manifest-path packages/oetf/rust/Cargo.toml --bin billie-oetf-runtime

FROM docker.io/library/debian:12.12-slim
COPY --from=build /src/packages/oetf/rust/target/release/billie-oetf-runtime /usr/local/bin/billie-oetf-runtime

ENV BILLIE_INPUT_BIND=0.0.0.0
ENV BILLIE_INPUT_PORT=5100
ENV BILLIE_INPUT_TRANSPORT=udp
ENV BILLIE_TRANSLATOR_SOCKET=/run/billie/translator.sock
EXPOSE 5100/udp 5100/tcp
CMD ["/usr/local/bin/billie-oetf-runtime"]
