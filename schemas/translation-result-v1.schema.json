{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-billie.example/schemas/translation-result-v1.schema.json",
  "title": "Billie translation result v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "requestId", "status", "outputName", "format", "bytesPublished"],
      "properties": {
        "apiVersion": { "const": "billie.dev/translation-v1" },
        "kind": { "const": "TranslateResult" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "const": "published" },
        "outputName": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "format": { "enum": ["cot", "asterix-cat062", "sapient"] },
        "bytesPublished": { "type": "integer", "minimum": 0 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "requestId", "status", "error"],
      "properties": {
        "apiVersion": { "const": "billie.dev/translation-v1" },
        "kind": { "const": "TranslateResult" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "const": "rejected" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1, "maxLength": 128 },
            "message": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "path": { "type": "string", "maxLength": 512 }
          }
        }
      }
    }
  ]
}
