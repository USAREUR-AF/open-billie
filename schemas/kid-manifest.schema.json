{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-billie.example/schemas/kid-manifest.schema.json",
  "title": "Open Billie kid package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "runtime", "components", "interfaces"],
  "properties": {
    "apiVersion": { "const": "billie.dev/v1" },
    "kind": { "const": "KidPackage" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "displayName"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 2000 },
        "repository": { "type": "string", "format": "uri" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "command"],
      "properties": {
        "image": { "type": "string", "pattern": "^.+@sha256:[a-f0-9]{64}$" },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "environment": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        },
        "persistentPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/(?!\\.)[A-Za-z0-9_./-]+$" }
        }
      }
    },
    "decoderImplementations": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^(python|rust|typescript)$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "decoder", "mapper"],
          "properties": {
            "status": { "enum": ["deployable", "library-only"] },
            "decoder": { "$ref": "#/$defs/relativePath" },
            "mapper": { "$ref": "#/$defs/relativePath" },
            "containerfile": { "$ref": "#/$defs/relativePath" },
            "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
          },
          "allOf": [
            {
              "if": { "properties": { "status": { "const": "deployable" } }, "required": ["status"] },
              "then": { "required": ["containerfile", "command"] }
            },
            {
              "if": { "properties": { "status": { "const": "library-only" } }, "required": ["status"] },
              "then": { "required": ["reason"] }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decoder", "mapper", "schemas", "mappings", "lookups", "vectors"],
      "properties": {
        "decoder": { "$ref": "#/$defs/relativePath" },
        "mapper": { "$ref": "#/$defs/relativePath" },
        "schemas": { "$ref": "#/$defs/relativePath" },
        "mappings": { "$ref": "#/$defs/relativePath" },
        "lookups": { "$ref": "#/$defs/relativePath" },
        "vectors": { "$ref": "#/$defs/relativePath" }
      }
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "outputs"],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "transport", "port"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
              "transport": {
                "enum": ["udp", "tcp"],
                "description": "Transport implemented by this package listener. CLI selection cannot add an unsupported transport."
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535,
                "description": "Port listened on inside the kid container. The operator may choose a different node host port during configuration."
              }
            }
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "format"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
              "format": { "enum": ["cot", "asterix-cat062", "sapient"] },
              "profile": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          }
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$" }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    }
  }
}
